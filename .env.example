# Copiar a .env (no se commitea). MS5 — Analítico (Athena).

PORT=8005
LOG_LEVEL=info
ENV=local

# Athena / AWS. En EC2 se usa LabInstanceProfile -> NO poner claves aquí.
AWS_REGION=us-east-1
ATHENA_DATABASE=aeropuerto_lake
ATHENA_OUTPUT=s3://mla-aeropuerto-lake/athena-results/
ATHENA_WORKGROUP=primary
ATHENA_CACHE_TTL_SECONDS=300
